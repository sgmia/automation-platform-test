# Configuration for entra-static-server, read at startup from the working directory.
#
# This file is committed and must stay free of secrets. Put the client secret and
# any personal overrides in .env.local, which is git-ignored and read after this
# file, so the same key there wins. An ENTRA_* environment variable beats both.

# --- Entra ID: signing users in -------------------------------------------
# Required. Both are public identifiers; they appear in the sign-in URL.
ENTRA_TENANT_ID=fcb2b37b-5da0-466b-9b83-0014b67a7c78 # Bayer
ENTRA_CLIENT_ID=8637bbe4-718a-46d5-9d43-dfbdf4f50866 # Brave SSO

# --- This server ----------------------------------------------------------
# Sets the host and port served, the redirect URI registered with Entra, and
# whether the session cookie is marked Secure. Changing this needs a matching
# redirect URI on the app registration.
ENTRA_BASE_URL=http://localhost:3000

# The directory served. Defaults to the static/ folder inside the package;
# only this directory is ever exposed.
# ENTRA_STATIC_DIR=

# Where Entra ID posts the id_token back to. Part of the redirect URI, so
# changing it needs the same change on the app registration.
# ENTRA_CALLBACK_PATH=/oauth2/token

# The prefix the page's own routes live under. Requests below it are answered
# 401 rather than redirected to Entra, because a fetch cannot follow a redirect
# to Microsoft. Changing it also needs the paths in the page changed to match:
# static/index.html is a static file and cannot read this.
# ENTRA_API_PREFIX=/api/

# The name of the session cookie. Renaming it signs everyone out at once, since
# the cookie a browser is already holding is no longer the one looked for.
# ENTRA_SESSION_COOKIE=session

# --- Lifetimes, in seconds ------------------------------------------------
ENTRA_SESSION_TTL=28800 # 8 hours
ENTRA_LOGIN_TTL=600 # 10 minutes

# Signs the session cookie, which is where the session actually lives. It is a
# secret, so it belongs in .env.local; left unset, each process signs with a key
# of its own and a restart signs everyone out.
# ENTRA_COOKIE_SECRET=

ENTRA_CLOCK_SKEW=60
ENTRA_HTTP_TIMEOUT=10.0

# --- Backend API: the client credentials flow -----------------------------
# All four are needed to enable it; leave them empty and every request is sent
# from the browser, unauthenticated. ENTRA_BACKEND_CLIENT_SECRET belongs in
# .env.local.
ENTRA_BACKEND_CLIENT_ID=1a84399e-58b0-4b55-b42a-f03855fd95ee # brave-api-user
ENTRA_BACKEND_SCOPE=api://brave-api-development/.default

# The only URL prefix this server will forward a request to, credentials
# attached. Anything else the page sends itself, with nothing of ours on it.
ENTRA_BACKEND_URL=https://nodered-api-ot.dev.brave.int.bayer.com/nodes/

# How long to wait on the backend. Separate from ENTRA_HTTP_TIMEOUT above: an
# API can take longer to answer than Entra ID does.
ENTRA_BACKEND_TIMEOUT=30.0
