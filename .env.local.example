# Copy to .env.local, which is git-ignored and read after .env.
#
# Secrets and personal overrides only -- everything else belongs in .env.

# The client secret of the backend app registration. Setting this alone is not
# enough: ENTRA_BACKEND_CLIENT_ID, _SCOPE and _URL must be filled in too.
ENTRA_BACKEND_CLIENT_SECRET=

# Signs the session cookie. Leave it out and each process signs with a key of its
# own, so a restart signs everyone out; set it to keep sessions across restarts.
# Any long random string will do: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENTRA_COOKIE_SECRET=

# Anything from .env can be overridden here, for example:
# ENTRA_BASE_URL=http://localhost:8080
